# Copy to deploy/.env and fill in. Never commit deploy/.env.
PHX_HOST=ai.mcpharbor.dev

# Loopback port the release listens on behind nginx. Must be free on the server.
APP_PORT=4610

# openssl rand -hex 24   (hex only: it is embedded in a database URL)
POSTGRES_PASSWORD=

# mix phx.gen.secret
SECRET_KEY_BASE=

# openssl rand -hex 32   (bearer token for POST /api/v0/servers; blank disables API publishing)
REGISTRY_PUBLISH_TOKEN=

# Seriously Simple Analytics account ID (blank disables analytics)
SSA_ACCOUNT_ID=
SSA_PROJECT=mcp-registry
